# Copy to .env.local and fill in. Never commit real values.
# Without DATABASE_URL the app uses a local PGlite database (apps/web/.data/pglite).

# --- In-app assistant (Vercel AI Gateway) ---
AI_GATEWAY_API_KEY=
# Hard monthly spend caps in USD, enforced from the ai_usage table before every request.
AI_MONTHLY_BUDGET_USD=100
AI_ORG_MONTHLY_USD=2
# Per-user request limits (rolling minute / hour).
AI_USER_PER_MINUTE=10
AI_USER_PER_HOUR=60
# Opt-in: only available on Vercel Pro/Enterprise teams (Hobby gets HTTP 403).
AI_ZERO_DATA_RETENTION=0

# --- Bank sync (Fio API tokens are stored encrypted) ---
# 32 random bytes, base64: `openssl rand -base64 32`. Losing or changing it makes stored tokens unreadable
# (owners just paste them again). Required for the "Fio token" setting; statement upload works without it.
ENCRYPTION_KEY=

# --- Local development ---
# Needed when `pnpm dev` does not get port 3000 (another dev server is running).
# BETTER_AUTH_URL=http://localhost:3000

# Local-only test account for manual/agent dogfooding against PGlite. Sign up once at /registrace.
# These are fake credentials for a throwaway local database, not for any real service.
TEST_USER_EMAIL=assistant-test@example.test
TEST_USER_PASSWORD=test-password-123
