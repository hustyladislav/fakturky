{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e"],
  "compilerOptions": {
    "target": "ES2023",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
