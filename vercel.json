{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm db:migrate && pnpm build && rm -rf .vercel/output && cp -R apps/web/.vercel/output .vercel/output",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/recurring",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 6 * * *"
    }
  ]
}
